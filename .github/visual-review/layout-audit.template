<!doctype html>
<html lang="en"><head><meta charset="utf-8"><title>Multilingual portrait layout audit</title></head>
<body data-done="false"><pre id="result">{"status":"pending"}</pre>
<script>
const params = new URLSearchParams(location.search);
const width = Number(params.get('width'));
const height = Number(params.get('height'));
const tests = [
  {name:'home-ar', path:'/', portrait:'.hero-portrait', copy:'.home-hero-grid>div:first-child'},
  {name:'home-en', path:'/en/', portrait:'.hero-portrait', copy:'.home-hero-grid>div:first-child'},
  {name:'home-de', path:'/de/', portrait:'.hero-portrait', copy:'.home-hero-grid>div:first-child'},
  {name:'about-ar', path:'/about/', portrait:'.profile-portrait', copy:'.profile-grid>div:first-child'},
  {name:'about-en', path:'/en/about/', portrait:'.profile-portrait', copy:'.profile-grid>div:first-child'},
  {name:'about-de', path:'/de/about/', portrait:'.profile-portrait', copy:'.profile-grid>div:first-child'}
];
const round = value => Math.round(value * 100) / 100;
const twoFrames = () => new Promise(resolve => requestAnimationFrame(() => requestAnimationFrame(resolve)));
const waitForLoad = frame => new Promise((resolve, reject) => {
  const timer = setTimeout(() => reject(new Error(`iframe timeout: ${frame.src}`)), 6000);
  frame.onload = () => { clearTimeout(timer); resolve(); };
  frame.onerror = () => { clearTimeout(timer); reject(new Error(`iframe load failed: ${frame.src}`)); };
});
function rect(value) {
  return {top:round(value.top), right:round(value.right), bottom:round(value.bottom), left:round(value.left), width:round(value.width), height:round(value.height)};
}
async function measure(test) {
  const frame = document.createElement('iframe');
  frame.style.cssText = `position:fixed;inset:0;width:${width}px;height:${height}px;border:0;opacity:0;pointer-events:none`;
  document.body.appendChild(frame);
  const loaded = waitForLoad(frame);
  frame.src = `${test.path}?layout_audit=ux10`;
  await loaded;
  await twoFrames();
  const doc = frame.contentDocument;
  const portrait = doc.querySelector(test.portrait);
  const image = portrait && portrait.querySelector('img');
  const copy = doc.querySelector(test.copy);
  if (!portrait || !image || !copy) throw new Error(`${test.name}: required layout selector missing`);
  const portraitRect = portrait.getBoundingClientRect();
  const imageRect = image.getBoundingClientRect();
  const copyRect = copy.getBoundingClientRect();
  const overlapWidth = Math.max(0, Math.min(portraitRect.right, copyRect.right) - Math.max(portraitRect.left, copyRect.left));
  const overlapHeight = Math.max(0, Math.min(portraitRect.bottom, copyRect.bottom) - Math.max(portraitRect.top, copyRect.top));
  const style = frame.contentWindow.getComputedStyle(image);
  const result = {
    name:test.name,
    viewport:{width:frame.contentWindow.innerWidth,height:frame.contentWindow.innerHeight},
    document:{scrollWidth:doc.documentElement.scrollWidth,clientWidth:doc.documentElement.clientWidth},
    portrait:rect(portraitRect),
    image:rect(imageRect),
    copy:rect(copyRect),
    overlapArea:round(overlapWidth * overlapHeight),
    verticalGap:round(copyRect.top - portraitRect.bottom),
    objectFit:style.objectFit,
    objectPosition:style.objectPosition
  };
  frame.remove();
  return result;
}
(async () => {
  try {
    const results = [];
    for (const test of tests) results.push(await measure(test));
    document.getElementById('result').textContent = JSON.stringify({status:'complete',results});
    document.body.dataset.done = 'true';
  } catch (error) {
    document.getElementById('result').textContent = JSON.stringify({status:'error',error:String(error)});
    document.body.dataset.done = 'error';
  }
})();
</script></body></html>
