{
  "schema_version": 2,
  "project": "ahmed-alhafiz.github.io",
  "project_name_ar": "الموقع الرسمي لأحمد الحافظ",
  "policy_version": "2.0",
  "protected_branch": "main",
  "enforcement": {
    "branch_protection_required": true,
    "direct_push_to_main_allowed": false,
    "force_push_allowed": false,
    "pull_request_required": true,
    "pr_policy_required": true,
    "red_team_required": true,
    "explicit_unverified_section_required": true
  },
  "handoff": {
    "source_of_truth": "GitHub",
    "concurrent_work_on_same_branch_allowed": false,
    "protocol": "DEVICE_HANDOFF_PROTOCOL.md",
    "live_state_file": "PROJECT_STATE.json"
  },
  "cost_control": {
    "heavy_ci_before_ready_pr": false,
    "prefer_local_or_targeted_checks_during_iteration": true,
    "quality_may_not_be_reduced_to_save_cost": true
  },
  "path_policy": {
    "code": ["*.html", "**/*.html", "assets/**", "tools/**", "articles/**", "en/**", "data/**", "author.json", "CITATION.cff", ".github/**"],
    "ui": ["*.html", "**/*.html", "assets/**"],
    "sensitive": ["articles/**", "data/**", "author.json", "CITATION.cff"],
    "tests": ["tools/**", ".github/visual-review/**"],
    "governance": ["PROJECT_CONSTITUTION.md", "PRODUCT_SPEC.md", "DECISIONS.md", "QUALITY_GATES.md", "AGENTS.md", "PROJECT_OS.json", "DEVICE_HANDOFF_PROTOCOL.md", "BRANCH_PROTECTION.md", ".github/governance/**", ".github/workflows/pr-policy.yml", ".github/workflows/governance-integrity.yml", ".github/PULL_REQUEST_TEMPLATE.md"]
  }
}
