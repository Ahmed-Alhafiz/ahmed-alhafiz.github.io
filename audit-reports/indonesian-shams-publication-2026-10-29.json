  "quran_quotes": [
    {
      "unit": "M025",
      "ar": "﴿وَمَا كَفَرَ سُلَيْمَانُ وَلَٰكِنَّ الشَّيَاطِينَ كَفَرُوا يُعَلِّمُونَ النَّاسَ السِّحْرَ﴾"
    },
    {
      "unit": "M027",
      "ar": "﴿وَيَتَعَلَّمُونَ مَا يَضُرُّهُمْ وَلَا يَنفَعُهُمْ﴾."
    },
    {
      "unit": "M036",
      "ar": "﴿وَمَا هُم بِضَارِّينَ بِهِ مِنْ أَحَدٍ إِلَّا بِإِذْنِ اللَّهِ﴾"
    },
    {
      "unit": "M039",
      "ar": "﴿وَلَا تَقْفُ مَا لَيْسَ لَكَ بِهِ عِلْمٌ إِنَّ السَّمْعَ وَالْبَصَرَ وَالْفُؤَادَ كُلُّ أُولَٰئِكَ كَانَ عَنْهُ مَسْئُولًا﴾"
    }
  ],
  "hadith_quote": "«اعْرِضُوا عَلَيَّ رُقَاكُمْ، لَا بَأْسَ بِالرُّقَى مَا لَمْ يَكُنْ فِيهِ شِرْكٌ».",
  "quran_meanings": {
    "provider": "QuranEnc.com",
    "key": "indonesian_affairs",
    "version": "1.0.1",
    "excerpts": [
      {
        "unit": "M025",
        "file": "sources/quranenc-affairs-2-102.json",
        "sha256": "cadd92f619228e03db64acaf9a3cde2b295736fdcc3b56320666fc29063b0b46",
        "sura": "2",
        "aya": "102",
        "id_excerpt": "Sulaiman itu tidak kafir tetapi setan-setan itulah yang kafir, mereka mengajarkan sihir kepada manusia",
        "exact_substring": true,
        "footnotes_in_source": ""
      },
      {
        "unit": "M027",
        "file": "sources/quranenc-affairs-2-102.json",
        "sha256": "cadd92f619228e03db64acaf9a3cde2b295736fdcc3b56320666fc29063b0b46",
        "sura": "2",
        "aya": "102",
        "id_excerpt": "Mereka mempelajari sesuatu yang mencelakakan, dan tidak memberi manfaat kepada mereka.",
        "exact_substring": true,
        "footnotes_in_source": ""
      },
      {
        "unit": "M036",
        "file": "sources/quranenc-affairs-2-102.json",
        "sha256": "cadd92f619228e03db64acaf9a3cde2b295736fdcc3b56320666fc29063b0b46",
        "sura": "2",
        "aya": "102",
        "id_excerpt": "Mereka tidak akan dapat mencelakakan seseorang dengan sihirnya kecuali dengan izin Allah.",
